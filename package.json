{
  "name": "agroinspekt-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:sqlite": "node scripts/db-provider.mjs sqlite",
    "db:postgres": "node scripts/db-provider.mjs postgresql",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:setup": "prisma db push && prisma db seed",
    "db:setup:local": "node scripts/db-provider.mjs sqlite && prisma db push && prisma db seed",
    "db:reset:local": "node scripts/db-provider.mjs sqlite && prisma db push --force-reset && prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^11.18.0",
    "gsap": "^3.15.0",
    "jose": "^6.2.8",
    "lenis": "^1.1.18",
    "next": "^15.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.9",
    "typescript": "^5.7.3"
  }
}
