// Agroinspekt admin + content database.
//
// PROVIDER SWITCHING (this is the "provider switchable" setup):
//   - Production (Netlify): PostgreSQL. The committed provider below is
//     "postgresql" so the Netlify build generates the correct client.
//   - Local development / demo: SQLite (zero setup). Run `npm run db:sqlite`
//     to switch this provider to sqlite locally (leave that change
//     uncommitted), then `npm run db:setup`. `npm run db:postgres` switches
//     it back. Models below use only types supported by BOTH engines, so the
//     same schema runs on either without edits beyond the provider line.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; the rhel target is the Netlify/AWS Lambda runtime
  // so the query engine is present in production (no serverless engine error).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Admin users. Email + password (hashed with bcrypt).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// The eight inspection domains. Seeded from src/config/services.ts.
/// TRANSLATABLE fields hold a locale-map JSON string, e.g.
///   title       -> {"en":"...","si":"..."}
///   covers      -> {"en":["...","..."],"si":["...","..."]}
/// Adding a language later means adding a locale key to these maps (via the
/// admin) — no schema migration. Stored as String for SQLite/Postgres parity.
model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  order       Int      @default(0)
  published   Boolean  @default(true)
  icon        String   @default("general")
  title       String   @default("{}")
  tagline     String   @default("{}")
  intro       String   @default("{}")
  covers      String   @default("{}")
  commodities String   @default("{}")
  methods     String   @default("{}")
  standards   String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Operational inspection records — the foundation for the 2027 mobile app.
model Inspection {
  id           String    @id @default(cuid())
  reference    String?
  commodity    String
  serviceSlug  String?
  client       String?
  location     String?
  status       String    @default("scheduled") // scheduled | in_progress | completed
  scheduledFor DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Enquiries submitted through the public contact form.
model Enquiry {
  id          String   @id @default(cuid())
  name        String
  company     String?
  email       String
  phone       String?
  commodity   String?
  serviceType String?
  location    String?
  dateFrom    String?
  dateTo      String?
  message     String?
  locale      String   @default("en")
  handled     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

/// The four homepage counting figures. `label` is a locale-map JSON string.
model Metric {
  id        String   @id @default(cuid())
  order     Int      @default(0)
  value     Int
  suffix    String   @default("+")
  label     String   @default("{}")
  updatedAt DateTime @updatedAt
}

/// Editable site content + flags, keyed (e.g. "metrics.showCaption",
/// "metrics.caption", "finalCta.title"). `value` is a locale-map JSON string;
/// flags store {"en":"true"} and are read locale-agnostically.
model Setting {
  key       String   @id
  value     String?  @default("{}")
  updatedAt DateTime @updatedAt
}
