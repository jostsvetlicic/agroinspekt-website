# ─────────────────────────────────────────────────────────────────────────
#  Environment variables. Copy to `.env` for local dev (gitignored), and set
#  the same keys in Netlify → Site settings → Environment variables for prod.
# ─────────────────────────────────────────────────────────────────────────

# Database.
#   Local (SQLite):     file:./dev.db
#   Production (Postgres, e.g. Neon/Supabase/Railway):
#     postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL="file:./dev.db"

# Session signing secret for the admin (JWT). Generate with:
#   openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Initial admin user, created by `npm run db:seed` when no users exist.
ADMIN_EMAIL="admin@agroinspekt.si"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Agroinspekt Admin"

# Optional: contact form also emails via Formspree (Formspree dashboard → form).
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
